# Build context exclusions.
#
# Without this file the context was the whole repository -- 5.5 GB, dominated
# by 4.8 GB of `datasets/` runtime data plus the frontend's node_modules and
# build output. None of it belongs in the image: `datasets/` and `logs/` are
# volume-mounted by docker-compose, and the frontend is served separately.

# Frontend: node_modules and build output are reinstalled/rebuilt, never copied
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Runtime data (volume-mounted by docker-compose, not baked into the image)
datasets/
logs/
*.db

# Regenerable scoring artifacts
artifacts/

# VCS and local tooling
.git/
.gitignore
.github/
venv/
.venv/
.pytest_cache/
__pycache__/
*.pyc
*.pyo

# Secrets -- must never enter an image layer
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
*.swp
