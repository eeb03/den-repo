# Database
DATABASE_URL=postgresql://subterra:subterra@db:5432/subterra_data
# For local dev without Docker/Postgres, use SQLite instead:
# DATABASE_URL=sqlite:///./subterra_dev.db

# Storage
DATA_ROOT=./datasets
STORAGE_BACKEND=local        # local | s3 | minio
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Logging
LOG_LEVEL=INFO

# Authentication / password reset
# Which environment this is. Anything other than development/dev/test/local is
# treated as production: the console mailer is refused there.
SUBTERRA_ENV=development
# Where the emailed reset link points. Configured, never taken from the request
# Host header. Must be absolute, with a scheme.
SUBTERRA_APP_URL=http://localhost:3000
# How long a reset link stays valid, in seconds (default 1800 = 30 minutes).
SUBTERRA_PASSWORD_RESET_TTL_SECONDS=1800

# Password-reset email delivery.
#   console = write the link to the log (development only)
#   resend  = send through Resend (production)
# There is no fallback: `resend` without a key or a sender fails at startup
# rather than quietly writing live reset links into the log.
SUBTERRA_EMAIL_PROVIDER=console
# Required when SUBTERRA_EMAIL_PROVIDER=resend. Create at
# https://resend.com/api-keys -- keep it out of version control.
RESEND_API_KEY=
# Required when SUBTERRA_EMAIL_PROVIDER=resend. The sending domain must be
# verified in Resend first, or delivery will be rejected or filtered.
# Example: Subterra AI <no-reply@mail.example.com>
SUBTERRA_EMAIL_FROM=
# Optional. Where replies go, if anywhere.
SUBTERRA_EMAIL_REPLY_TO=
# Optional. Bounded provider timeout in seconds (default 10, max 60).
SUBTERRA_EMAIL_TIMEOUT_SECONDS=

# External dataset sources
# OpenTopography: request a free key at https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=
# Zenodo: optional personal access token, raises search rate limit from 25 to 100 results/page
# https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_ACCESS_TOKEN=
