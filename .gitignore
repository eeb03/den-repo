# Secrets
.env

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# Runtime data (downloaded/generated, not source).
# Anchored to the repository root: unanchored, `datasets/` also matched any
# nested directory of that name and silently excluded frontend source under
# frontend/app/(workspace)/datasets/.
/datasets/
/logs/
*.db

# Characterisation artifacts: regenerable from the corpus via
# scripts/characterise_4tu.py; the 14 MB JSON is not source.
/artifacts/

# Generated by `next dev` (Next 16, generate-agent-files.js), not written by
# hand. They carry a Next.js advisory to coding agents and no Subterra content.
# Deleting them is not durable -- the dev server rewrites AGENTS.md on every
# run -- so they are ignored rather than committed or repeatedly removed.
/frontend/AGENTS.md
/frontend/CLAUDE.md
